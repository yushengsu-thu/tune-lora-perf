# dev model pack — Qwen3.5-35B-A3B-FP8-expert_shared (sourced by dev/common.sh after MODEL resolved).
# Variant of dev/models/Qwen3.5-35B-A3B-FP8/model.env that turns ON experts_shared_outer_loras and
# serves an AUTO-GENERATED shared-outer DUMMY adapter (random weights) so the shared-outer expert
# LoRA path can be perf-tested. This is a PERF pack (decode throughput) — the dummy carries no
# reference logprobs, so accuracy/KL is N/A: run bench only (steps 1,2,3); skip 4_run_acc / 5_profile.
# Deltas vs the base FP8 pack (dev/models/Qwen3.5-35B-A3B-FP8/model.env):
#   * LORA_EXTRA adds --experts-shared-outer-loras (FORCE-enable). dev/gen_dummy_lora.py auto-detects
#     this flag (forwarded by common.sh as DL_LORA_EXTRA) and emits the 3D shared-outer expert layout
#     (gate/up lora_A + down lora_B shared across experts, expert_dim=1) instead of per-expert 2D.
#   * Rank-parameterized: ESO_RANK (default 32) drives BOTH --max-lora-rank and dummy:<rank>, so the
#     SAME pack serves rank 16 and rank 32 — override per run:
#         ESO_RANK=16 bash dev/3_run_benchmark.sh qwen35-fp8-expert
#         ESO_RANK=32 bash dev/3_run_benchmark.sh qwen35-fp8-expert
#     The dummy adapter path encodes the rank (/data/<MODEL>-dummy-lora-r<rank>), so the two never clash.
#   * PACK points at the base FP8 regression pack so we reuse its pod.yaml; POD_PREFIX is the SAME as
#     the base pack -> shares the base's running pod (no separate launch — the bench comparison's
#     normal-r16 / no-lora arms run on this very pod from the base pack).
# Everything else mirrors the base FP8 pack: FP8 base, --mamba-scheduler-strategy extra_buffer KEPT
# (this is a hybrid GDN+MoE model — UNLIKE the 30B BF16 expert_shared, which has no mamba state and
# crashes if it is enabled), allreduce-fusion ON, trtllm_mha, experimental_sgl_trtllm, virtual-experts,
# TP4/EP4, the four SGLANG_*_LORA opt envs.
# Available at source time: DEV_DIR ROOT_DIR MODEL MODEL_DIR PORT LORA_NAME FLASHINFER_PIN.

ESO_RANK="${ESO_RANK:-32}"                     # rank knob for this pack: set ESO_RANK=16 or 32 (default 32)
NNODES=1; TP=4; EP=4; GPUS_PER_NODE=4
POD_PREFIX="sglang-gb300-qwen35-yushengsu"     # SAME prefix as the base FP8 pack -> reuses its running pod
MODEL_PATH=/data/Qwen3.5-35B-A3B-FP8
LORA_PATH=dummy:${ESO_RANK}                     # auto-generated shared-outer dummy at this rank (see header)
SERVER_COMMON="--model-path ${MODEL_PATH} --tp ${TP} --ep ${EP} --host 0.0.0.0 --port ${PORT} \
--mem-fraction-static 0.8 --trust-remote-code --cuda-graph-max-bs 128 --max-prefill-tokens 65536 \
--chunked-prefill-size 4096 --mamba-scheduler-strategy extra_buffer \
--enable-flashinfer-allreduce-fusion --attention-backend trtllm_mha"
ENV_COMMON="PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True"
LORA_EXTRA="--moe-runner-backend experimental_sgl_trtllm --lora-use-virtual-experts \
--experts-shared-outer-loras \
--enable-lora --max-loras-per-batch 1 --max-lora-rank ${ESO_RANK} --lora-backend triton \
--lora-paths ${LORA_NAME}=${LORA_PATH}"
# MAIN_ALLOC=1 REQUIRED (without it decode = garbage); never DOWN_FINALIZE_OVERLAP / ENABLE_PDL.
LORA_ENVS="SGLANG_EXPERIMENTAL_LORA_OPTI=1 SGLANG_OPT_LORA_OVERLAP_MAIN_ALLOC=1 \
SGLANG_OPT_LORA_SHARED_ADD_OVERLAP=1 SGLANG_OPT_LORA_CUBLAS=1"
BENCH_BS="16 32 64"; BENCH_IN=2048; BENCH_OUT=2048
ACC_TOL=1.0                              # N/A — dummy random adapter has no reference logprobs; bench only
PROF_RECIPE="64 8 24 48"                 # bs start-step steps output-len (only if profiling later)
TRACE_RANKS="0 1 2 3"
READY_TIMEOUT_MIN=45                      # first sm_103 cold JIT can exceed 30 min
POD_READY_TIMEOUT=20m
PACK="${PACK:-${ROOT_DIR}/regression/gb300/models/Qwen3.5-35B-A3B-FP8}"   # reuse base FP8 pod.yaml
