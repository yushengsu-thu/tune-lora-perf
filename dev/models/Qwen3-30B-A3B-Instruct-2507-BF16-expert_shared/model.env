# dev model pack — Qwen3-30B-A3B-Instruct-2507-BF16-expert_shared
#   (sourced by dev/common.sh after MODEL is resolved).
# Variant of dev/models/Qwen3-30B-A3B-Instruct-2507-BF16/model.env that turns ON
# experts_shared_outer_loras and serves a REAL trained adapter (+ its bundled vLLM/trainer
# reference logprobs) instead of the random dummy. Deltas vs the base BF16 pack:
#   * LORA_EXTRA adds --experts-shared-outer-loras (FORCE-enable; overrides auto-detect, so it
#     applies regardless of whether adapter_config.json carries the tag — this one does NOT).
#   * --max-lora-rank 32 (the adapter is r=32, alpha=32; the base pack used 16).
#   * LORA_PATH=hf + LORA_HF_REPO -> dev/common.sh resolves it to a /data dir and
#     1_launch_node's ensure_hf_lora `hf download`s the repo onto each pod (pod HF_TOKEN auth).
#     The repo (yushengsu/lora-diff-Qwen3-30B-A3B-Instruct-2507) is SELF-CONTAINED:
#       adapter_model.safetensors + adapter_config.json + compare_sample_train_data.pt.
#   * acc: NO ACC_HF_FILE — the bundled compare_sample_train_data.pt sits at
#     ${LORA_PATH}/compare_sample_train_data.pt, which is exactly 4_run_acc's default ACC_DATA,
#     so the sglang-vs-vLLM/trainer KL comparison runs automatically (and the shared-outer tag
#     gate in 4_run_acc is NOT tripped because it only fires when ACC_HF_FILE is set).
# Everything else mirrors the base BF16 pack (bf16 base, experimental_sgl_trtllm, trtllm_mha,
# virtual-experts, allreduce-fusion off, TP4/EP4, the four SGLANG_*_LORA opt envs).
# Available at source time: DEV_DIR ROOT_DIR MODEL MODEL_DIR PORT LORA_NAME FLASHINFER_PIN.

NNODES=1; TP=4; EP=4; GPUS_PER_NODE=4
POD_PREFIX="sglang-gb300-qwen330-yushengsu"   # SAME prefix as the base BF16 pack -> reuses its running pod
MODEL_PATH=/data/Qwen3-30B-A3B-Instruct-2507
LORA_PATH=hf                                  # real adapter pulled from HF (see LORA_HF_REPO)
LORA_HF_REPO=yushengsu/lora-diff-Qwen3-30B-A3B-Instruct-2507
LORA_HF_REPO_TYPE=dataset
# allreduce fusion ON: verified end-to-end on branch 526e0ae22 (capture + warmup + real base/lora
# inference all clean) — the old "fusion -> illegal memory access" no longer reproduces (journal §5).
# reasoning/tool-call parsers are API-layer (enable the qwen3 thinking + qwen3_coder tool format).
# NOTE: --mamba-scheduler-strategy is intentionally ABSENT — this is a standard-attention MoE (no
# mamba state); enabling it crashes in _mamba_radix_cache_v2_req_prepare_for_extend.
SERVER_COMMON="--model-path ${MODEL_PATH} --tp ${TP} --ep ${EP} --host 0.0.0.0 --port ${PORT} \
--mem-fraction-static 0.8 --trust-remote-code --cuda-graph-max-bs 128 --max-prefill-tokens 65536 \
--chunked-prefill-size 4096 --enable-flashinfer-allreduce-fusion --attention-backend trtllm_mha \
--reasoning-parser qwen3 --tool-call-parser qwen3_coder"
ENV_COMMON="PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True"
LORA_EXTRA="--moe-runner-backend experimental_sgl_trtllm --lora-use-virtual-experts \
--experts-shared-outer-loras \
--enable-lora --max-loras-per-batch 1 --max-lora-rank 32 --lora-backend triton \
--lora-paths ${LORA_NAME}=${LORA_PATH}"
# no-lora cell carries the non-LoRA serving flags too (same MoE backend as the lora cell), so the
# no-lora baseline isn't on a different (default) backend -> overhead = pure LoRA effect.
NOLORA_EXTRA="--moe-runner-backend experimental_sgl_trtllm"
# MAIN_ALLOC=1 REQUIRED (without it decode = garbage); never DOWN_FINALIZE_OVERLAP / ENABLE_PDL.
LORA_ENVS="SGLANG_EXPERIMENTAL_LORA_OPTI=1 SGLANG_OPT_LORA_OVERLAP_MAIN_ALLOC=1 \
SGLANG_OPT_LORA_SHARED_ADD_OVERLAP=1 SGLANG_OPT_LORA_CUBLAS=1 \
SGLANG_OPT_USE_JIT_KERNEL_MOE_ALIGN=1 SGLANG_OPT_FUSED_MOE_ACTIVATION_VEC=1"
BENCH_BS="16 32 64"; BENCH_IN=2048; BENCH_OUT=2048
ACC_TOL=0.30                             # real trained adapter -> genuinely diverges from base; the
                                         # hard signal is the KL-vs-reference table, not this tol.
PROF_RECIPE="64 8 24 48"                 # bs start-step steps output-len
TRACE_RANKS="0 1 2 3"
READY_TIMEOUT_MIN=45                      # first sm_103 cold JIT can exceed 30 min
POD_READY_TIMEOUT=20m
POD_YAML="${POD_YAML:-${DEV_DIR}/models/${MODEL}/pod.yaml}"   # self-contained (env-overridable)
