# dev model pack — Qwen3.5-35B-A3B-FP8-normal_dummy (sourced by dev/common.sh after MODEL resolved).
# Per-expert (NORMAL, NOT shared-outer) DUMMY adapter, rank-parameterized — the matched-coverage
# counterpart to Qwen3.5-35B-A3B-FP8-expert_shared. Both use auto-generated dummies with the SAME
# DL_TARGETS (q,k,v,o,gate,up,down_proj), so a normal-vs-expert_shared comparison at fixed rank
# isolates the LoRA *layout/structure* cost (no real-vs-dummy / module-coverage confound), and
# r16-vs-r32 isolates the *rank* cost. PERF only (random weights → no accuracy/KL).
# Deltas vs the base FP8 pack: LORA_PATH=dummy:${ND_RANK} (per-expert; NO --experts-shared-outer-loras),
# --max-lora-rank ${ND_RANK}. mamba extra_buffer kept; PACK/POD_PREFIX reuse the base FP8 pod.
# Available at source time: DEV_DIR ROOT_DIR MODEL MODEL_DIR PORT LORA_NAME FLASHINFER_PIN.

ND_RANK="${ND_RANK:-16}"                        # rank knob: ND_RANK=16 or 32 (default 16)
NNODES=1; TP=4; EP=4; GPUS_PER_NODE=4
POD_PREFIX="sglang-gb300-qwen35-yushengsu"      # SAME prefix as base FP8 pack -> reuses its running pod
MODEL_PATH=/data/Qwen3.5-35B-A3B-FP8
LORA_PATH=dummy:${ND_RANK}                       # per-expert dummy (no eso flag -> gen emits 2D per-expert)
SERVER_COMMON="--model-path ${MODEL_PATH} --tp ${TP} --ep ${EP} --host 0.0.0.0 --port ${PORT} \
--mem-fraction-static 0.8 --trust-remote-code --cuda-graph-max-bs 128 --max-prefill-tokens 65536 \
--chunked-prefill-size 4096 --mamba-scheduler-strategy extra_buffer \
--enable-flashinfer-allreduce-fusion --attention-backend trtllm_mha"
ENV_COMMON="PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True"
LORA_EXTRA="--moe-runner-backend experimental_sgl_trtllm --lora-use-virtual-experts \
--enable-lora --max-loras-per-batch 1 --max-lora-rank ${ND_RANK} --lora-backend triton \
--lora-paths ${LORA_NAME}=${LORA_PATH}"
LORA_ENVS="SGLANG_EXPERIMENTAL_LORA_OPTI=1 SGLANG_OPT_LORA_OVERLAP_MAIN_ALLOC=1 \
SGLANG_OPT_LORA_SHARED_ADD_OVERLAP=1 SGLANG_OPT_LORA_CUBLAS=1"
BENCH_BS="16 32 64"; BENCH_IN=2048; BENCH_OUT=2048
ACC_TOL=1.0                              # N/A — dummy; perf only
PROF_RECIPE="64 8 24 48"                 # bs start-step steps output-len
TRACE_RANKS="0"                          # rank0 suffices for the overhead analysis (keeps uploads light)
READY_TIMEOUT_MIN=45
POD_READY_TIMEOUT=20m
PACK="${PACK:-${ROOT_DIR}/regression/gb300/models/Qwen3.5-35B-A3B-FP8}"   # reuse base FP8 pod.yaml
