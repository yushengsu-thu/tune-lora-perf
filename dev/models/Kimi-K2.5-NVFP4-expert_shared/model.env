# dev model pack — Kimi-K2.5-NVFP4-expert_shared (sourced by dev/common.sh after MODEL resolves).
# The shared-outer (TML) rank-32 variant of dev/models/Kimi-K2.5-NVFP4/model.env, built from the
# authoritative PR#4 e2e script ../e2e_test_scripts/gb300/Kimi-K2.5-NVFP4_pr4_run_gb300.sh.
# Deltas vs the base Kimi-K2.5-NVFP4 pack:
#   * LORA_EXTRA adds --experts-shared-outer-loras (FORCE-enable: the adapter_config has NO
#     shared-outer tag, so the flag is mandatory) and --max-lora-rank 32 (was 16).
#   * LORA_PATH = /root/lora-diff-Kimi-K2.5 — the REAL adapter (hf.co/datasets/yushengsu/
#     lora-diff-Kimi-K2.5: r32, shared-outer, all-linear), downloaded by the e2e
#     Kimi-K2.5-NVFP4-gb300.yaml setup; it bundles compare_sample_train_data.pt (vLLM/trainer
#     reference logprobs) so 4_run_acc's default ACC_DATA = ${LORA_PATH}/compare_sample_train_data.pt
#     drives the sglang-vs-vLLM/trainer KL comparison automatically (shared-outer tag NOT tripped).
#   * Everything else mirrors the base Kimi pack: NVFP4 (modelopt_fp4), experimental_sgl_trtllm,
#     virtual-experts, multi-node TP8/EP8, and the REQUIRED kimi opt envs.
# POD REUSE: POD_PREFIX=mnnvl-kimi + ID=gb300 (in dev/.state/<model>.env) targets the LIVE e2e pods
#   mnnvl-kimi-gb300-0/1 + service mnnvl-kimi-gb300-head (already warm, weights + adapter present) —
#   dev names pods ${POD_PREFIX}-${ID}-${n} and head svc ${POD_PREFIX}-${ID}-head, which match exactly.
#   So skip 1_launch_node; just write .state and run 2_upload → 3_bench → 5_profile → 6_upload.
# Available at source time: DEV_DIR ROOT_DIR MODEL PORT LORA_NAME FLASHINFER_PIN.

NNODES=2; TP=8; EP=8; GPUS_PER_NODE=4
POD_PREFIX="mnnvl-kimi"               # + ID=gb300 -> live pods mnnvl-kimi-gb300-{0,1} / -head svc
MODEL_PATH=/root/Kimi-K2.5-NVFP4
LORA_PATH=/root/lora-diff-Kimi-K2.5   # r32 shared-outer adapter (already on the pods; + acc reference)
DIST_PORT=20000                       # required when NNODES > 1; matches the e2e dist-init service
SERVER_COMMON="--model-path ${MODEL_PATH} --tp ${TP} --ep ${EP} --host 0.0.0.0 --port ${PORT} \
--quantization modelopt_fp4 --mem-fraction-static 0.83 --trust-remote-code --cuda-graph-max-bs 128 \
--max-prefill-tokens 40960 --chunked-prefill-size 40960 --dist-timeout 1800"
ENV_COMMON="NCCL_MNNVL_ENABLE=1 NCCL_NVLS_ENABLE=1 NCCL_CUMEM_ENABLE=1 \
SGLANG_ENABLE_TP_MEMORY_INBALANCE_CHECK=false PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True"
# no-lora cell shares the same MoE backend so the bench ratio isolates pure LoRA overhead.
NOLORA_EXTRA="--moe-runner-backend experimental_sgl_trtllm"
LORA_EXTRA="--moe-runner-backend experimental_sgl_trtllm --lora-use-virtual-experts \
--experts-shared-outer-loras \
--enable-lora --max-loras-per-batch 1 --max-lora-rank 32 --lora-backend triton \
--lora-paths ${LORA_NAME}=${LORA_PATH}"
# REQUIRED for kimi NVFP4 LoRA (regression kimi MODEL.md + PR#4 script):
#   PER_TOKEN_ACTIVATION=1  -> else input_scale!=1 -> lora garbage
#   NVFP4_GEMM_SWIGLU_FUSION=0 -> else fusion bypasses the LoRA delta under --enable-lora
# Guardrails: NEVER SGLANG_OPT_LORA_DOWN_FINALIZE_OVERLAP / SGLANG_OPT_LORA_ENABLE_PDL. autotune ON.
LORA_ENVS="SGLANG_EXPERIMENTAL_LORA_OPTI=1 SGLANG_FLASHINFER_NVFP4_PER_TOKEN_ACTIVATION=1 \
SGLANG_ENABLE_NVFP4_GEMM_SWIGLU_FUSION=0 SGLANG_OPT_USE_JIT_KERNEL_KIMI_GATE=1 \
SGLANG_OPT_USE_JIT_KERNEL_MOE_ALIGN=1 SGLANG_OPT_FUSED_PERMUTE_QUANT=1 \
SGLANG_OPT_FUSED_MOE_ACTIVATION_QUANT_FUSE=1"
BENCH_BS="16 32 64"; BENCH_IN=2048; BENCH_OUT=2048
ACC_TOL=0.30                          # real trained adapter -> diverges from base; KL table is the signal
PROF_RECIPE="16 4 12 64"              # bs start-step steps output-len (graph-ON real timing)
TRACE_RANKS="0 1 2 3 4 5 6 7"         # 8 ranks across BOTH pods (rank/4 -> pod index)
PROF_OFF="16 4 12 64"; TRACE_RANKS_OFF="0"   # graph-OFF kernel structure (TP0 suffices)
READY_TIMEOUT_MIN=50                  # cold fp4 autotune is process-local (re-tunes every launch)
POD_READY_TIMEOUT=25m
# relaunch (only if pods gone): the e2e yaml downloads weights + the r32 shared-outer adapter.
POD_YAML="${POD_YAML:-${ROOT_DIR}/e2e_test_scripts/gb300/Kimi-K2.5-NVFP4-gb300.yaml}"
