# dev model pack — Qwen3-30B-A3B-Instruct-2507-BF16 (sourced by dev/common.sh after MODEL is resolved).
# Modeled on dev/models/Qwen3.5-35B-A3B-FP8/model.env, with bf16 deltas:
#   * base model is BF16 (Qwen/Qwen3-30B-A3B-Instruct-2507), not FP8.
#   * GOAL: bf16 support INSIDE the experimental_sgl_trtllm LoRA path (currently FP8/NVFP4-only — it
#     asserts on bf16). That sglang work is in progress on branch qwen3-30b-a3b-2507-bf16; this pack
#     keeps --moe-runner-backend experimental_sgl_trtllm so the dev flow exercises that path.
#     (A config-only Triton fallback was verified to work as a baseline — see ./journal.md — but the
#     target is bf16 in the experimental path itself.)
#   * allreduce fusion is FORCE-DISABLED: --enable-flashinfer-allreduce-fusion crashed the bf16 LoRA
#     path during cuda-graph capture (allreduce_fusion_op illegal memory access); the verified-good
#     bf16 config has it off.
#   * Qwen3-30B-A3B-Instruct-2507 is a STANDARD attention MoE (no mamba/linear layers), so the
#     --mamba-scheduler-strategy flag from the qwen35 hybrid pack is DROPPED.
#   * no real adapter yet -> LORA_PATH=dummy (common.sh resolves it to a /data path and step 1's
#     ensure_dummy_lora generates a rank-16 mock covering attention + shared_expert + routed experts).
#   * self-contained pod spec (no regression pack for this model): POD_YAML points at this dir.
# Available at source time: DEV_DIR ROOT_DIR MODEL MODEL_DIR PORT LORA_NAME FLASHINFER_PIN.

NNODES=1; TP=4; EP=4; GPUS_PER_NODE=4
POD_PREFIX="sglang-gb300-qwen330-yushengsu"
MODEL_PATH=/data/Qwen3-30B-A3B-Instruct-2507
LORA_PATH=dummy:16                       # no real adapter — auto-generate a rank-16 mock on /data
SERVER_COMMON="--model-path ${MODEL_PATH} --tp ${TP} --ep ${EP} --host 0.0.0.0 --port ${PORT} \
--mem-fraction-static 0.8 --trust-remote-code --cuda-graph-max-bs 128 --max-prefill-tokens 65536 \
--chunked-prefill-size 4096 --enforce-disable-flashinfer-allreduce-fusion --attention-backend trtllm_mha"
ENV_COMMON="PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True"
LORA_EXTRA="--moe-runner-backend experimental_sgl_trtllm --lora-use-virtual-experts \
--enable-lora --max-loras-per-batch 1 --max-lora-rank 16 --lora-backend triton \
--lora-paths ${LORA_NAME}=${LORA_PATH}"
# MAIN_ALLOC=1 REQUIRED (without it decode = garbage); never DOWN_FINALIZE_OVERLAP / ENABLE_PDL.
LORA_ENVS="SGLANG_EXPERIMENTAL_LORA_OPTI=1 SGLANG_OPT_LORA_OVERLAP_MAIN_ALLOC=1 \
SGLANG_OPT_LORA_SHARED_ADD_OVERLAP=1 SGLANG_OPT_LORA_CUBLAS=1"
BENCH_BS="16 32 64"; BENCH_IN=2048; BENCH_OUT=2048
ACC_TOL=0.05                             # UNMEASURED placeholder; the dummy adapter is random-init (NOT near-identity)
PROF_RECIPE="64 8 24 48"                 # bs start-step steps output-len (forwards 8-31 all decode)
TRACE_RANKS="0 1 2 3"
READY_TIMEOUT_MIN=45                      # first sm_103 cold JIT can exceed 30 min
POD_READY_TIMEOUT=20m
POD_YAML="${POD_YAML:-${DEV_DIR}/models/${MODEL}/pod.yaml}"   # self-contained dev pod spec (env-overridable, e.g. a node-pinned copy)
