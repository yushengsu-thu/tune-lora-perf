# Qwen3.5-35B-A3B-FP8 — model parameters for regression/scripts/run_regression.sh
# VALUES ONLY (model-specific logic goes in hooks.sh). See MODEL.md for the WHY behind each value.
# Launch flags come from tune-lora-perf/run_script.sh (Yanbin's Qwen3.5 LoRA launch).

MODEL=Qwen3.5-35B-A3B-FP8-gb300
MODEL_DISPLAY="Qwen3.5-35B-A3B-FP8 (GB300)"
TAG_PREFIX=Qwen3.5-35B-A3B-FP8-gb300-reg                  # publish.sh RUN_TAG prefix: Qwen3.5-35B-A3B-FP8-gb300-reg-<shorthash>-<ts>

# ---- topology ----
NNODES=1                               # single node, 4 GPU
TP=4
EP=4
GPUS_PER_NODE=4
POD_TEMPLATE='sglang-gb300-qwen3vl-yushengsu-${ID}'   # user's workload naming convention; set ID=$(date +%Y%m%d-%H%M%S)
HEAD_SVC_TEMPLATE=''                   # unused when NNODES=1
DIST_PORT=""
PORT=30000

# ---- model / LoRA (persistent per-node big disk — see pod.yaml /data mount) ----
MODEL_PATH=/data/Qwen3.5-35B-A3B-FP8
LORA_PATH=/data/qwen35_35b_lora_alpha
LORA_NAME=alpha
MAX_LORA_RANK=16

# ---- server args/envs common to BOTH cells (fair comparison; from PR #27329's qwen launch) ----
QUANT_ARGS=""                          # FP8 checkpoint — no quantization flag
MEM_FRACTION=0.8
EXTRA_COMMON="--cuda-graph-max-bs 128 --max-prefill-tokens 65536 --chunked-prefill-size 4096 --mamba-scheduler-strategy extra_buffer --enable-flashinfer-allreduce-fusion --attention-backend trtllm_mha"
LAUNCH_ENV_COMMON="PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True"

# ---- default cells: base (control) vs variant (candidate) — EDIT per A/B ----
# DEFAULT: no-LoRA base (stock default backend = the %-ceiling)  vs  the PR #27329 experimental
# fast LoRA path (yushengsu-thu:trtllm-lora-bf16). For an ACC REGRESSION check make the cells
# NUMERICALLY EQUIVALENT (e.g. env-on vs env-off).
BASE_REF=__bench_base
BASE_LORA=off
BASE_EXTRA=""
BASE_ENVS=""
VARIANT_REF=__bench_variant
VARIANT_LORA=on
VARIANT_EXTRA="--moe-runner-backend experimental_sgl_trtllm --lora-use-virtual-experts"
# qwen3.5 opt set per PR #27329: EXPERIMENTAL_LORA_OPTI=1 is the MASTER SWITCH (off = upstream
# byte-identical); MAIN_ALLOC=1 REQUIRED (mamba + cuda-graph WAR — without it decode =
# 'Thinking!!!!' garbage that the prefill-only acc CANNOT see); SHARED_ADD_OVERLAP + CUBLAS = perf.
# NEVER set SGLANG_OPT_LORA_DOWN_FINALIZE_OVERLAP or SGLANG_OPT_LORA_ENABLE_PDL. See MODEL.md.
VARIANT_ENVS="SGLANG_EXPERIMENTAL_LORA_OPTI=1 SGLANG_OPT_LORA_OVERLAP_MAIN_ALLOC=1 SGLANG_OPT_LORA_SHARED_ADD_OVERLAP=1 SGLANG_OPT_LORA_CUBLAS=1"

# ---- workload / profile recipe ----
BENCH_BS="16 32 64"
IN=2048
OUT=2048
PROF_ON="64 8 24 48"                   # bs start-step steps output-len — run_script.sh's
                                       # clean-decode recipe: forwards 8-31 are ALL decode
PROF_OFF="16 4 12 64"
TRACE_RANKS_ON="0 1 2 3"               # all 4 TP ranks (single pod)
TRACE_RANKS_OFF="0"                    # TP0 only (kernel structure)
READY_TIMEOUT_MIN=45                   # sm_103 cold trtllm_lora_temp JIT exceeded 30 min (attempt-1 timeout on the 2026-06-06 validation; retry passed on the warm cache) — give the FIRST variant launch enough headroom

# ---- analysis (recorded into meta.env for summary.py) ----
ACC_TOL=0.05                           # UNMEASURED placeholder — run same-config twice for the
                                       # real floor (kimi's measured floor was ~0.26-0.30)
LAYERS=""                              # dynamic — hooks.sh record_layers reads config.json
FLASHINFER_PIN=0.6.11.post1   # must match the pinned image flashinfer-jit-cache (pod.yaml digest note)
