# Kimi-K2.5-NVFP4 — model parameters for regression/scripts/run_regression.sh
# VALUES ONLY (model-specific logic goes in hooks.sh). See MODEL.md for the WHY behind each value.
# Sourced by bash: keep it `key=value`, single-quote the ${ID}/${NODE} templates (expanded later).

MODEL=kimi
MODEL_DISPLAY="Kimi-K2.5-NVFP4"
TAG_PREFIX=kimi-reg                    # publish.sh RUN_TAG prefix: kimi-reg-<shorthash>-<ts>

# ---- topology ----
NNODES=2                               # 2-node MNNVL: worker/head launch order + DNS rendezvous
TP=8
EP=""                                  # empty = no --ep flag (kimi regression runs TP8, no EP)
GPUS_PER_NODE=4                        # rank -> pod mapping for pull_traces (TP0-3 head, TP4-7 worker)
POD_TEMPLATE='mnnvl-kimi-${ID}-${NODE}'
HEAD_SVC_TEMPLATE='mnnvl-kimi-${ID}-head'
DIST_PORT=20000
PORT=30000

# ---- model / LoRA ----
MODEL_PATH=/root/Kimi-K2.5-NVFP4
LORA_PATH=/root/kimi_k25_lora_alpha
LORA_NAME=alpha
MAX_LORA_RANK=32

# ---- server args/envs common to BOTH cells (fair comparison) ----
QUANT_ARGS="--quantization modelopt_fp4"
MEM_FRACTION=0.83                      # NOT 0.88 — the trtllm-LoRA decomposed path OOMs at 0.88 (MODEL.md)
EXTRA_COMMON="--cuda-graph-max-bs 64 --max-prefill-tokens 40960 --chunked-prefill-size 40960"
LAUNCH_ENV_COMMON="NCCL_MNNVL_ENABLE=1 NCCL_NVLS_ENABLE=1 NCCL_CUMEM_ENABLE=1 SGLANG_ENABLE_TP_MEMORY_INBALANCE_CHECK=false PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True"

# ---- default cells: base (control) vs variant (candidate) — EDIT per A/B ----
# Each cell = REF (injected branch, SKILL.md §3) + LORA on/off + EXTRA server flags + ENVS prefix.
# DEFAULT: no-LoRA base  vs  trtllm-LoRA + the kimi opt stack (two-stream is always-on at HEAD).
# For an ACC REGRESSION check make the cells NUMERICALLY EQUIVALENT (e.g. trtllm-LoRA vs
# cutlass-LoRA) — base-vs-LoRA is an *intended* diff, not a regression.
BASE_REF=__bench_base
BASE_LORA=off
BASE_EXTRA=""
BASE_ENVS=""
VARIANT_REF=__bench_variant
VARIANT_LORA=on
VARIANT_EXTRA="--moe-runner-backend sgl_flashinfer_trtllm --lora-use-virtual-experts"
# kimi NVFP4 LoRA opt stack: PER_TOKEN_ACTIVATION=1 REQUIRED (else lora garbage);
# SWIGLU_FUSION=0 REQUIRED (fusion is lora-incompatible on kimi); rest = perf knobs. See MODEL.md.
VARIANT_ENVS="SGLANG_FLASHINFER_NVFP4_PER_TOKEN_ACTIVATION=1 SGLANG_ENABLE_NVFP4_GEMM_SWIGLU_FUSION=0 SGLANG_OPT_LORA_SHRINK_TUNE=1 SGLANG_ENABLE_LORA_SHRINK_SPLIT_K=1"

# ---- workload / profile recipe ----
BENCH_BS="16 32 64"
IN=2048
OUT=2048
PROF_ON="16 4 12 64"                   # bs start-step steps output-len (graph-ON: bs16 only — bs64
                                       # added profile time without changing the decode read)
PROF_OFF="16 4 12 64"
TRACE_RANKS_ON="0 1 2 3 4 5 6 7"       # ALL 8 TP ranks across BOTH pods (~4.4M each)
TRACE_RANKS_OFF="0"                    # TP0 only (~39M; kernel structure, 1 rank suffices)
READY_TIMEOUT_MIN=40                   # cold fp4_gemm autotune ~17-21 min is NORMAL (MODEL.md)

# ---- analysis (recorded into meta.env for summary.py) ----
ACC_TOL=0.30                           # MEASURED atomic-add noise floor — not 0.01 (MODEL.md)
LAYERS=61                              # Kimi-K2.5 = 1 dense + 60 MoE hidden layers
